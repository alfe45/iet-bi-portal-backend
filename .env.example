# ============================================================
# POSTGRESQL
# ============================================================
DB_HOST=ip_address
DB_PORT=port_number
DB_NAME=db_name
DB_USER=user_name 
DB_PASSWORD=password

# ============================================================
# JWT
# ============================================================
JWT_KEY=CAMBIA_ESTA_CLAVE_POR_UNA_CLAVE_LARGA_Y_ALEATORIA
JWT_ISSUER=issuer_name
JWT_AUDIENCE=audience_name

JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# ============================================================
# SEGURIDAD DE LOGIN
# ============================================================
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=2
ADMIN_BOOTSTRAP_TOKEN="TU_TOKEN_DE_BOOTSTRAP_AQUI_MAS_LARGO_Y_ALEATORIO_QUE_EL_DE_ARRIBA_PARA_MAYOR_SEGURIDAD_QUE_EL_DE_ARRIBA"

# ============================================================
# DESPLIEGUE (opcionales)
# ============================================================
# Origenes del frontend separados por comas (por defecto http://localhost:4200)
# CORS_ORIGINS=https://mi-frontend.onrender.com
# true solo detras de un proxy inverso como Render (IP real del cliente para el rate limiting)
# CONFIAR_PROXY=true

# ============================================================
# CORREO (Profesor Regular CU12, RP-61)
# ============================================================
# brevo = API HTTP de Brevo (produccion; Render free bloquea SMTP) | carpeta = guarda cada correo como .eml (local y pruebas)
CORREO_PROVEEDOR=carpeta
# Remitente verificado en el proveedor
CORREO_REMITENTE=portal@ejemplo.com
CORREO_REMITENTE_NOMBRE=Portal IET-BI
# Solo con brevo: clave de la API (Brevo > SMTP & API > API Keys)
# BREVO_API_KEY=xkeysib-...
# Solo con carpeta: carpeta donde se guardan los .eml (relativa a la carpeta desde donde corre la API)
CORREO_CARPETA=correo_salida
