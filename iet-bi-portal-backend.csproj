    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>iet_bi_portal_backend</RootNamespace>
    <UserSecretsId>00ebbaff-dbfd-41a7-beff-5136ec6188c7</UserSecretsId>
