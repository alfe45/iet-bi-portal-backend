<mxfile host="app.diagrams.net"><diagram id="dominio" name="Modelo de dominio"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="3000" pageHeight="2400" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="titulo" value="Modelo de dominio — IET BI Portal (iteración 3)" style="text;html=1;fontSize=28;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="0" y="-150" width="1400" height="40" as="geometry"/></mxCell><mxCell id="subtitulo" value="Un solo modelo para todo el sistema. Cada clase persistente corresponde a una tabla del modelo entidad-relación (modelo_entidad_relacion_it3.drawio)." style="text;html=1;fontSize=14;fontColor=#555555;align=left;" vertex="1" parent="1"><mxGeometry x="0" y="-110" width="1600" height="26" as="geometry"/></mxCell><mxCell id="c_Usuario" value="&lt;b&gt;Usuario&lt;/b&gt;" style="swimlane;fontStyle=0;html=1;align=center;startSize=30;horizontal=1;collapsible=0;marginBottom=0;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#ffffff;fontSize=13;" vertex="1" parent="1"><mxGeometry x="440" y="0" width="340" height="279" as="geometry"/></mxCell><mxCell id="c_Usuario_a" value="- id: Guid&lt;br&gt;- email: string&lt;br&gt;- activo: bool&lt;br&gt;- roles: Rol[1..*]&lt;br&gt;- intentosFallidos: int&lt;br&gt;- bloqueadoHasta: DateTime [0..1]&lt;br&gt;- ultimoLogin: DateTime [0..1]&lt;br&gt;- tokensInvalidadosDesde: DateTime [0..1]" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingTop=-2;fontSize=11;fontFamily=Consolas;" vertex="1" parent="c_Usuario"><mxGeometry y="30" width="340" height="128" as="geometry"/></mxCell><mxCell id="c_Usuario_l" value="" style="line;strokeWidth=1;fillColor=none;strokeColor=#6c8ebf;points=[];portConstraint=eastwest;" vertex="1" parent="c_Usuario"><mxGeometry y="158" width="340" height="8" as="geometry"/></mxCell><mxCell id="c_Usuar