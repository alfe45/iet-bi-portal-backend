oToMany;endFill=0;startFill=0;endSize=12;startSize=12;strokeColor=#10739e;strokeWidth=1.6;fontColor=#10739e;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;" edge="1" parent="1" source="t_experiencias_cas_id_informe" target="t_informes_cas_id_informe"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r29h" value="0..N" style="edgeLabel;html=1;fontSize=12;fontStyle=1;fontColor=#10739e;labelBackgroundColor=#ffffff;align=center;verticalAlign=middle;" vertex="1" connectable="0" parent="r29"><mxGeometry x="-0.82" relative="1" as="geometry"><mxPoint y="-11" as="offset"/></mxGeometry></mxCell><mxCell id="r29p" value="1" style="edgeLabel;html=1;fontSize=12;fontStyle=1;fontColor=#10739e;labelBackgroundColor=#ffffff;align=center;verticalAlign=middle;" vertex="1" connectable="0" parent="r29"><mxGeometry x="0.82" relative="1" as="geometry"><mxPoint y="-11" as="offset"/></mxGeometry></mxCell><mxCell id="leyenda_areas" value="Áreas" style="swimlane;fontStyle=1;startSize=30;html=1;fillColor=#f5f5f5;strokeColor=#999999;rounded=1;arcSize=4;fontSize=14;swimlaneFillColor=#ffffff;collapsible=0;" vertex="1" parent="1"><mxGeometry x="40" y="1232" width="330" height="244" as="geometry"/></mxCell><mxCell id="area0" value="Seguridad y auditoría (api)" style="rounded=1;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="leyenda_areas"><mxGeometry x="10" y="38" width="310" height="26" as="geometry"/></mxCell><mxCell id="area1" value="Personas" style="rounded=1;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="leyenda_areas"><mxGeometry x="10" y="72" width="310" height="26" as="geometry"/></mxCell><mxCell id="area2" value="Estructura académica" style="rounded=1;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="leyenda_areas"><mxGeometry x="10" y="106" width="310" height="26" as="geometry"/></mxCell><mxCell id="area3" value="Asistencia y notas" style="rounded=1;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="leyenda_areas"><mxGeometry x="10" y="140" width="310" height="26" as="geometry"/></mxCell><mxCell id="area4" value="Monografías" style="rounded=1;html=1;fillColor=#fad9d5;strokeColor=#ae4132;strokeWidth=2;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="leyenda_areas"><mxGeometry x="10" y="174" width="310" height="26" as="geometry"/></mxCell><mxCell id="area5" value="CAS" style="rounded=1;html=1;fillColor=#d0eef0;strokeColor=#10739e;strokeWidth=2;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="leyenda_areas"><mxGeometry x="10" y="208" width="310" height="26" as="geometry"/></mxCell><mxCell id="leyenda" value="&lt;b&gt;Notación (pata de gallo)&lt;/b&gt;&lt;br&gt;─┼ uno obligatorio · ─o┼ cero o uno · ─o&amp;lt; cero o muchos&lt;br&gt;Cada extremo indica además la cardinalidad: 1, 0..1 o 0..N.&lt;br&gt;Las líneas toman el color del área de la tabla padre.&lt;br&gt;&lt;span style='color:#b85450'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/span&gt; clave primaria · &lt;span style='color:#10739e'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/span&gt; clave foránea · &lt;b&gt;UQ&lt;/b&gt; único · &lt;b&gt;?&lt;/b&gt; admite NULL&lt;br&gt;&lt;br&gt;&lt;b&gt;Tipos enumerados&lt;/b&gt;&lt;br&gt;api.roles: ADMIN, PROFESOR_REGULAR, PROFESOR_CAS, GUIA, COORD_MONOGRAFIA, COORD_CAS&lt;br&gt;tipo_asignatura: TRONCAL, SUPERIOR, MEDIO, MEP&lt;br&gt;numero_semestre: I_SEMESTRE, II_SEMESTRE&lt;br&gt;estado_monografia: CAPACITACION, INVESTIGACION, TERMINADA&lt;br&gt;estado_periodo / estado_matricula: derivados por función (no se guardan)&lt;br&gt;&lt;br&gt;&lt;b&gt;Notas&lt;/b&gt;&lt;br&gt;matriculas → secciones es una FK compuesta (id_seccion, id_periodo).&lt;br&gt;logs.id_usuario no tiene FK: la auditoría conserva al actor aunque se elimine." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;arcSize=3;" vertex="1" parent="1"><mxGeometry x="40" y="1506" width="890" height="270" as="geometry"/></mxCell><mxCell id="nota_dominio" value="&lt;b&gt;Correspondencia con el modelo de dominio (retroalimentación iteración 2)&lt;/b&gt;&lt;br&gt;• Cada tabla indica su clase del dominio (texto azul bajo el nombre); cada clase persistente del dominio tiene su tabla.&lt;br&gt;• confirmaciones_notas ↔ clase ConfirmacionNotas (antes faltaba en el dominio).&lt;br&gt;• &lt;b&gt;No son tablas&lt;/b&gt;: ReporteBandas, BandaAsignatura, MonografiaReporte y AvisoNotas son tipos de resultado (CREATE TYPE) que calculan funciones a partir de las tablas; por eso ya no aparecen como clases del dominio:&lt;br&gt;&amp;nbsp;&amp;nbsp;– fila_reporte_bandas ← academico.fn_guia_reporte_bandas (evaluaciones + confirmaciones_notas + ausencias)&lt;br&gt;&amp;nbsp;&amp;nbsp;– reporte_monografia_seccion ← academico.fn_guia_reportes_monografia (reportes_monografia)&lt;br&gt;&amp;nbsp;&amp;nbsp;– aviso_notas ← academico.fn_profesor_avisos_notas (evaluaciones + confirmaciones_notas + prorrogas)" style="shape=note;whiteSpace=wrap;html=1;size=16;align=left;verticalAlign=top;spacing=10;fontSize=13;fillColor=#fffbe6;strokeColor=#b3a24b;" vertex="1" parent="1"><mxGeometry x="1000" y="1506" width="1100" height="190" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
