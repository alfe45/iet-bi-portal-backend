seguimientos_monografia [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#ae4132" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#ae4132" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="13"><B>seguimientos_monografia</B></FONT><FONT COLOR="white" POINT-SIZE="10">  (academico)</FONT></TD></TR><TR><TD COLSPAN="3" BGCOLOR="#fad9d5" ALIGN="CENTER"><FONT COLOR="#1a4f8f" POINT-SIZE="10">clase: SeguimientoMonografia</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="42" PORT="id_seguimiento_w"><FONT POINT-SIZE="10"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><U>id_seguimiento</U></TD><TD ALIGN="LEFT" PORT="id_seguimiento_e"><FONT COLOR="#555555" POINT-SIZE="10">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="42" PORT="id_monografia_w"><FONT POINT-SIZE="10"><B>FK</B></FONT></TD><TD ALIGN="LEFT">id_monografia</TD><TD ALIGN="LEFT" PORT="id_monografia_e"><FONT COLOR="#555555" POINT-SIZE="10">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="42" PORT="fecha_w"><FONT POINT-SIZE="10"> </FONT></TD><TD ALIGN="LEFT">fecha</TD><TD ALIGN="LEFT" PORT="fecha_e"><FONT COLOR="#555555" POINT-SIZE="10">DATE</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="42" PORT="observacion_w"><FONT POINT-SIZE="10"> </FONT></TD><TD ALIGN="LEFT">observacion</TD><TD ALIGN="LEFT" PORT="observacion_e"><FONT COLOR="#555555" POINT-SIZE="10">VARCHAR(1000)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="42" PORT="creado_en_w"><FONT POINT-SIZE="10"> </FONT></TD><TD ALIGN="LEFT">creado_en</TD><TD ALIGN="LEFT" PORT="creado_en_e"><FONT COLOR="#555555" POINT-SIZE="10">TIMESTAMPTZ</FONT></TD></TR></TABLE>>];
reportes_monografia [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#ae4132" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#ae4132" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="13"><B>reportes_monografia</B></FONT><FONT COLOR="white" POINT-SIZE="10">  (academico)</FONT></TD></TR><TR><TD COLSPAN="3" BGCOLOR="#fad9d5" ALIGN="CENTER"><FONT COLOR="#1a4f8f" POINT-SIZE="10">clase: ReporteMonografia</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="42" PORT="id_monografia_w"><FONT POINT-SIZE="10"><B>PK,FK</B></FONT></TD><TD ALIGN="LEFT"><U>id_monografia</U></TD><TD ALIGN="LEFT" PORT="id_monografia_e"><FONT COLOR="#555555" POINT-SIZE="10">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="42" PORT="id_periodo_w"><FONT POINT-SIZE="10"><B>PK,FK</B></FONT></TD><TD ALIGN="LEFT"><U>id_periodo</U></TD><TD ALIGN="LEFT" PORT="id_periodo_e"><FONT COLOR="#555555" POINT-SIZE="10">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="42" PORT="semestre_w"><FONT POINT-SIZE="10"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><U>semestre</U></TD><TD ALIGN="LEFT" PORT="semestre_e"><FONT COLOR="#555555" POINT-SIZE="10">numero_semestre</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="42" PORT="observaciones_w"><FONT POINT-SIZE="10"> </FONT></TD><TD ALIGN="LEFT">observaciones</TD><TD ALIGN="LEFT" PORT="observaciones_e"><FONT COLOR="#555555" POINT-SIZE="10">VARCHAR(1000)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="42" PORT="enviado_en_w"><FONT POINT-SIZE="10"> </FONT></TD><TD ALIGN="LEFT">enviado_en</TD><TD ALIGN="LEFT" PORT="enviado_en_e"><FONT COLOR="#555555" POINT-SIZE="10">TIMESTAMPTZ?</FONT></TD></TR></TABLE>>];
informes_cas [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#10739e" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#10739e" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="13"><B>informes_cas</B></FONT><FONT COLOR="white" POINT-SIZE="10">  (academico)</FONT></TD></TR><TR><TD COLSPAN="3" BGCOLOR="#d0eef0" ALIGN="CENTER"><FONT COLOR="#1a4f8f" POINT-SIZE="10">clase: InformeCas</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="42" PORT="id_informe_w"><FONT POINT-SIZE="10"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><U>id_informe</U></TD><TD ALIGN="LEFT" PORT="id_informe_e"><FONT COLOR="#555555" POINT-SIZE="10">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="42" PORT="id_asignacion_w"><FONT POINT-SIZE="10"><B>FK</B></FONT></TD><TD ALIGN="LEFT">id_asignacion</TD><TD ALIGN="LEFT" PORT="id_asignacion_e"><FONT COLOR="#555555" POINT-SIZE="10">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="42" PORT="id_matricula_w"><FONT POINT-SIZE="10"><B>FK</B></FONT></TD><TD ALIGN="LEFT">id_matricula</TD><TD ALIGN="LEFT" PORT="id_matricula_e"><FONT COLOR="#555555" POINT-SIZE="10">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="42" PORT="semestre_w"><FONT POINT-SIZE="10"> </FONT></TD><TD ALIGN="LEFT">semestre</TD><TD ALIGN="LEFT" PORT="semestre_e"><FONT COLOR="#555555" POINT-SIZE="10">numero_semestre</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="42" PORT="perfil_w"><FONT POINT-SIZE="10"> </FONT></TD><TD ALIGN="LEFT">perfil</TD><TD ALIGN="LEFT" PORT="perfil_e"><FONT COLOR="#555555" POINT-SIZE="10">BOOLEAN</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="42" PORT="entrevista_1_w"><FONT POINT-SIZE="10"> </FONT></TD><TD ALIGN="LEFT">entrevista_1</TD><TD ALIGN="LEFT" PORT="entrevista_1_e"><FONT COLOR="#555555" POINT-SIZE="10">BOOLEAN</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="42" PORT="entrevista_2_w"><FONT POINT-SIZE="10"> </FONT></TD><TD ALIGN="LEFT">entrevista_2</TD><TD ALIGN="LEFT" PORT="entrevista_2_e"><FONT COLOR="#555555" POINT-SIZE="10">BOOLEAN</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="42" PORT="entrevista_final_w"><FONT POINT-SIZE="10"> </FONT></TD><TD ALIGN="LEFT">entrevista_final</TD><TD ALIGN="LEFT" PORT="entrevista_final_e"><FONT COLOR="#555555" POINT-SIZE="10">BOOLEAN</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="42" PORT="observaciones_w"><FONT POINT-SIZE="10"> </FONT></TD><TD ALIGN="LEFT">observaciones</TD><TD ALIGN="LEFT" PORT="observaciones_e"><FONT COLOR="#555555" POINT-SIZE="10">VARCHAR(2000)?</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="42" PORT="creado_en_w"><FONT POINT-SIZE="10"> </FONT></TD><TD ALIGN="LEFT">creado_en</TD><TD ALIGN="LEFT" PORT="creado_en_e"><FONT COLOR="#555555" POINT-SIZE="10">TIMESTAMPTZ</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="42" PORT="modificado_en_w"><FONT POINT-SIZE="10"> </FONT></TD><TD ALIGN="LEFT">modificado_en</TD><TD ALIGN="LEFT" PORT="modificado_en_e"><FONT COLOR="#555555" POINT-SIZE="10">TIMESTAMPTZ</FONT></TD></TR></TABLE>>];
experiencias_cas [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#10739e" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#10739e" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="13"><B>experiencias_cas</B></FONT><FONT COLOR="white" POINT-SIZE="10">  (academico)</FONT></TD></TR><TR><TD COLSPAN="3" BGCOLOR="#d0eef0" ALIGN="CENTER"><FONT COLOR="#1a4f8f" POINT-SIZE="10">clase: ExperienciaCas</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="42" PORT="id_informe_w"><FONT POINT-SIZE="10"><B>PK,FK</B></FONT></TD><TD ALIGN="LEFT"><U>id_informe</U></TD><TD ALIGN="LEFT" PORT="id_informe_e"><FONT COLOR="#555555" POINT-SIZE="10">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="42" PORT="orden_w"><FONT POINT-SIZE="10"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><U>orden</U></TD><TD ALIGN="LEFT" PORT="orden_e"><FONT COLOR="#555555" POINT-SIZE="10">SMALLINT (1..30)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="42" PORT="descripcion_w"><FONT POINT-SIZE="10"> </FONT></TD><TD ALIGN="LEFT">descripcion</TD><TD ALIGN="LEFT" PORT="descripcion_e"><FONT COLOR="#555555" POINT-SIZE="10">VARCHAR(255)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="42" PORT="fecha_inicio_w"><FONT POINT-SIZE="10"> </FONT></TD><TD ALIGN="LEFT">fecha_inicio</TD><TD ALIGN="LEFT" PORT="fecha_inicio_e"><FONT COLOR="#555555" POINT-SIZE="10">DATE?</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="42" PORT="fecha_fin_w"><FONT POINT-SIZE="10"> </FONT></TD><TD ALIGN="LEFT">fecha_fin</TD><TD ALIGN="LEFT" PORT="fecha_fin_e"><FONT COLOR="#555555" POINT-SIZE="10">DATE?</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="42" PORT="creatividad_w"><FONT POINT-SIZE="10"> </FONT></TD><TD ALIGN="LEFT">creatividad</TD><TD ALIGN="LEFT" PORT="creatividad_e"><FONT COLOR="#555555" POINT-SIZE="10">BOOLEAN</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="42" PORT="actividad_w"><FONT POINT-SIZE="10"> </FONT></TD><TD ALIGN="LEFT">actividad</TD><TD ALIGN="LEFT" PORT="actividad_e"><FONT COLOR="#555555" POINT-SIZE="10">BOOLEAN</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="42" PORT="servicio_w"><FONT POINT-SIZE="10"> </FONT></TD><TD ALIGN="LEFT">servicio</TD><TD ALIGN="LEFT" PORT="servicio_e"><FONT COLOR="#555555" POINT-SIZE="10">BOOLEAN</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="42" PORT="resultados_aprendizaje_w"><FONT POINT-SIZE="10"> </FONT></TD><TD ALIGN="LEFT">resultados_aprendizaje</TD><TD ALIGN="LEFT" PORT="resultados_aprendizaje_e"><FONT COLOR="#555555" POINT-SIZE="10">SMALLINT[]</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="42" PORT="carpeta_w"><FONT POINT-SIZE="10"> </FONT></TD><TD ALIGN="LEFT">carpeta</TD><TD ALIGN="LEFT" PORT="carpeta_e"><FONT COLOR="#555555" POINT-SIZE="10">BOOLEAN</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="42" PORT="reflexion_w"><FONT POINT-SIZE="10"> </FONT></TD><TD ALIGN="LEFT">reflexion</TD><TD ALIGN="LEFT" PORT="reflexion_e"><FONT COLOR="#555555" POINT-SIZE="10">BOOLEAN</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="42" PORT="pruebas_w"><FONT POINT-SIZE="10"> </FONT></TD><TD ALIGN="LEFT">pruebas</TD><TD ALIGN="LEFT" PORT="pruebas_e"><FONT COLOR="#555555" POINT-SIZE="10">BOOLEAN</FONT></TD></TR></TABLE>>];
usuarios:id_usuario_e:e -> usuario_roles:id_usuario_w:w [arrowtail=teetee, arrowhead=crowodot, color="#3d6aa8", label=<tiene>];
usuarios:id_usuario_e:e -> usuario_roles:asignado_por_w:w [arrowtail=teeodot, arrowhead=crowodot, color="#3d6aa8", label=<asignado por>];
usuarios:id_usuario_e:e -> sesiones:id_usuario_w:w [arrowtail=teetee, arrowhead=crowodot, color="#3d6aa8", label=<abre>];
usuarios:id_usuario_e:e -> bootstrap_admin:id_usuario_w:w [arrowtail=teeodot, arrowhead=teeodot, color="#3d6aa8", label=<primer admin>];
usuarios:id_usuario_e:e -> profesores:id_usuario_w:w [arrowtail=teeodot, arrowhead=teeodot, color="#3d6aa8", label=<cuenta>];
profesores:id_profesor_e:e -> prorrogas:id_profesor_w:w [arrowtail=teetee, arrowhead=crowodot, color="#7a4f99", label=<recibe>];
periodos_academicos:id_periodo_e:e -> prorrogas:id_periodo_w:w [arrowtail=teetee, arrowhead=crowodot, color="#4d8a37", label=<en>];
periodos_academicos:id_periodo_e:e -> secciones:id_periodo_w:w [arrowtail=teetee, arrowhead=crowodot, color="#4d8a37", label=<contiene>];
profesores:id_profesor_e:e -> secciones:id_profesor_guia_w:w [arrowtail=teeodot, arrowhead=crowodot, color="#7a4f99", label=<guía (1 por periodo)>];
secciones:id_seccion_e:e -> asignaciones_docentes:id_seccion_w:w [arrowtail=teetee, arrowhead=crowodot, color="#4d8a37", label=<imparte en>];
asignaturas:id_asignatura_e:e -> asignaciones_docentes:id_asignatura_w:w [arrowtail=teetee, arrowhead=crowodot, color="#4d8a37", label=<de>];
profesores:id_profesor_e:e -> asignaciones_docentes:id_profesor_w:w [arrowtail=teetee, arrowhead=crowodot, color="#7a4f99", label=<imparte>];
estudiantes:id_estudiante_e:e -> matriculas:id_estudiante_w:w [arrowtail=teetee, arrowhead=crowodot, color="#7a4f99", label=<se matricula (1 por periodo)>];
secciones:id_seccion_e:e -> matriculas:id_seccion_w:w [arrowtail=teetee, arrowhead=crowodot, color="#4d8a37", label=<en (FK compuesta)>];
asignaciones_docentes:id_asignacion_e:e -> confirmaciones_notas:id_asignacion_w:w [arrowtail=teetee, arrowhead=crowodot, color="#4d8a37", label=<confirma notas>];
asignaciones_docentes:id_asignacion_e:e -> lecciones:id_asignacion_w:w [arrowtail=teetee, arrowhead=crowodot, color="#4d8a37", label=<registra>];
lecciones:id_leccion_e:e -> ausencias:id_leccion_w:w [arrowtail=teetee, arrowhead=crowodot, color="#b87d00", label=<en>];
matriculas:id_matricula_e:e -> ausencias:id_matricula_w:w [arrowtail=teetee, arrowhead=crowodot, color="#4d8a37", label=<de>];
asignaciones_docentes:id_asignacion_e:e -> evaluaciones:id_asignacion_w:w [arrowtail=teetee, arrowhead=crowodot, color="#4d8a37", label=<califica>];
matriculas:id_matricula_e:e -> evaluaciones:id_matricula_w:w [arrowtail=teetee, arrowhead=crowodot, color="#4d8a37", label=<de>];
estudiantes:id_estudiante_e:e -> monografias:id_estudiante_w:w [arrowtail=teetee, arrowhead=teeodot, color="#7a4f99", label=<realiza>];
matriculas:id_matricula_e:e -> monografias:id_matricula_inicio_w:w [arrowtail=teetee, arrowhead=crowodot, color="#4d8a37", label=<inicia en>];
profesores:id_profesor_e:e -> monografias:id_coordinador_w:w [arrowtail=teetee, arrowhead=crowodot, color="#7a4f99", label=<coordina>];
asignaturas:id_asignatura_e:e -> monografias:id_asignatura_w:w [arrowtail=teetee, arrowhead=crowodot, color="#4d8a37", label=<en materia>];
monografias:id_monografia_e:e -> seguimientos_monografia:id_monografia_w:w [arrowtail=teetee, arrowhead=crowodot, color="#ae4132", label=<tiene>];
monografias:id_monografia_e:e -> reportes_monografia:id_monografia_w:w [arrowtail=teetee, arrowhead=crowodot, color="#ae4132", label=<reporta>];
periodos_academicos:id_periodo_e:e -> reportes_monografia:id_periodo_w:w [arrowtail=teetee, arrowhead=crowodot, color="#4d8a37", label=<en>];
asignaciones_docentes:id_asignacion_e:e -> informes_cas:id_asignacion_w:w [arrowtail=teetee, arrowhead=crowodot, color="#4d8a37", label=<CAS>];
matriculas:id_matricula_e:e -> informes_cas:id_matricula_w:w [arrowtail=teetee, arrowhead=crowodot, color="#4d8a37", label=<de>];
informes_cas:id_informe_e:e -> experiencias_cas:id_informe_w:w [arrowtail=teetee, arrowhead=crowodot, color="#10739e", label=<contiene>];
usuarios:id_usuario_e:e -> logs:id_usuario_w:w [style=dashed, color="#888888", dir=none, label=<actor (sin FK)>];
leyenda [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="2" CELLPADDING="3" COLOR="#999999" BGCOLOR="#fafafa"><TR><TD ALIGN="LEFT" COLSPAN="2"><B>Áreas</B></TD></TR><TR><TD BGCOLOR="#6c8ebf" WIDTH="16"> </TD><TD ALIGN="LEFT">Seguridad y auditoría (api)</TD></TR><TR><TD BGCOLOR="#9673a6" WIDTH="16"> </TD><TD ALIGN="LEFT">Personas</TD></TR><TR><TD BGCOLOR="#82b366" WIDTH="16"> </TD><TD ALIGN="LEFT">Estructura académica</TD></TR><TR><TD BGCOLOR="#d79b00" WIDTH="16"> </TD><TD ALIGN="LEFT">Asistencia y notas</TD></TR><TR><TD BGCOLOR="#ae4132" WIDTH="16"> </TD><TD ALIGN="LEFT">Monografías</TD></TR><TR><TD BGCOLOR="#10739e" WIDTH="16"> </TD><TD ALIGN="LEFT">CAS</TD></TR><TR><TD COLSPAN="2"> </TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><B>Notación (pata de gallo)</B></TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2">──┼┼  uno obligatorio      ──┼o  cero o uno      ──&lt;o  cero o muchos</TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2">La línea sale de la PK de la tabla padre y llega a la columna FK; toma el color del área de la tabla padre.</TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2">PK clave primaria · FK clave foránea · UQ único · ? admite NULL</TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"> </TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><B>Tipos enumerados</B></TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2">api.roles: ADMIN, PROFESOR_REGULAR, PROFESOR_CAS, GUIA, COORD_MONOGRAFIA, COORD_CAS</TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2">tipo_asignatura: TRONCAL, SUPERIOR, MEDIO, MEP · numero_semestre: I_SEMESTRE, II_SEMESTRE</TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2">estado_monografia: CAPACITACION, INVESTIGACION, TERMINADA</TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2">estado_periodo / estado_matricula: derivados por función (no se guardan)</TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"> </TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><B>Notas</B></TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2">• matriculas → secciones es una FK compuesta (id_seccion, id_periodo).</TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2">• logs.id_usuario no tiene FK (línea punteada): la auditoría conserva al actor aunque se elimine.</TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2">• profesores.id_usuario: la cuenta es obligatoria; solo es nula en profesores anteriores.</TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2">• Catálogo obligatorio (RP-25): CAS y MON son asignaturas del sistema (no se eliminan, siempre TRONCAL).</TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"> </TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><B>Correspondencia con el modelo de dominio</B></TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2">• Cada tabla indica su clase del dominio; cada clase persistente tiene su tabla.</TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2">• No son tablas: ReporteBandas, BandaAsignatura, MonografiaReporte y AvisoNotas son tipos de resultado</TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2">  (CREATE TYPE) que calculan funciones: academico.fn_guia_reporte_bandas,</TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2">  academico.fn_guia_reportes_monografia y academico.fn_profesor_avisos_notas.</TD></TR></TABLE>>];
{rank=same; experiencias_cas; seguimientos_monografia; leyenda}
}
