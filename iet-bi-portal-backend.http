# Pruebas manuales de la API. Ejecuta en orden: los borrados van al final porque los datos
# tienen dependencias (matrícula -> sección -> periodo, asignación -> asignatura/profesor...).
# @host según launchSettings.json: perfil "http" = http://localhost:5149, "https" = https://localhost:7128.
@host = http://localhost:5149
@bootstrapToken = REEMPLAZAR_CON_ADMIN_BOOTSTRAP_TOKEN
@adminEmail = admin@iet.test
@adminPass = Cambiar1234
@profeEmail = profe1@iet.test
@profePass = Profe12345
@cedulaProfe = 100000001
@cedulaEst = 200000001
@anio = 2026
@anioSiguiente = 2027

### Crear primer administrador (una sola vez)
POST {{host}}/api/setup/primer-admin
Content-Type: application/json
X-Bootstrap-Token: {{bootstrapToken}}

{ "email": "{{adminEmail}}", "contrasena": "{{adminPass}}" }

### Iniciar sesión
# @name login
POST {{host}}/api/auth/login
Content-Type: application/json

{ "email": "{{adminEmail}}", "contrasena": "{{adminPass}}" }

###
@token = {{login.response.body.$.accessToken}}
@refresh = {{login.response.body.$.refreshToken}}

### Renovar sesión
POST {{host}}/api/auth/refresh
Content-Type: application/json

{ "refreshToken": "{{refresh}}" }

### CU01 - Mi perfil (roles y, si tiene, perfil de profesor)
GET {{host}}/api/perfil
Authorization: Bearer {{token}}

### CU02 - Registrar usuario (nace con PROFESOR_REGULAR)
# @name nuevoUsuario
POST {{host}}/api/admin/usuarios
Authorization: Bearer {{token}}
Content-Type: application/json

{ "email": "{{profeEmail}}", "contrasena": "{{profePass}}" }

###
@idUsuario = {{nuevoUsuario.response.body.$.id}}

### CU03 - Listar usuarios (filtros opcionales: busqueda, rol)
GET {{host}}/api/admin/usuarios?pagina=1&tamanoPagina=20&busqueda=&rol=
Authorization: Bearer {{token}}

### CU03 - Detalle de usuario
GET {{host}}/api/admin/usuarios/{{idUsuario}}
Authorization: Bearer {{token}}

### CU04 - Modificar email
PATCH {{host}}/api/admin/usuarios/{{idUsuario}}/email
Authorization: Bearer {{token}}
Content-Type: application/json

{ "email": "profe1.nuevo@iet.test" }

### CU04 - Resetear contraseña
POST {{host}}/api/admin/usuarios/{{idUsuario}}/resetear-contrasena
Authorization: Bearer {{token}}
Content-Type: application/json

{ "contrasenaNueva": "{{profePass}}" }

### CU04 - Desactivar usuario
POST {{host}}/api/admin/usuarios/{{idUsuario}}/desactivar
Authorization: Bearer {{token}}

### CU04 - Activar usuario
POST {{host}}/api/admin/usuarios/{{idUsuario}}/activar
Authorization: Bearer {{token}}

### CU04 - Asignar rol (GUIA para poder ser guía de una sección)
POST {{host}}/api/admin/usuarios/{{idUsuario}}/roles
Authorization: Bearer {{token}}
Content-Type: application/json

{ "rol": "GUIA" }

### CU39 - Asignar como coordinador de monografía (en estas pruebas el mismo profesor tiene todos los roles)
POST {{host}}/api/admin/usuarios/{{idUsuario}}/roles
Authorization: Bearer {{token}}
Content-Type: application/json

{ "rol": "COORD_MONOGRAFIA" }

### CU04 - Rol PROFESOR_CAS (necesario para impartir la asignatura CAS)
POST {{host}}/api/admin/usuarios/{{idUsuario}}/roles
Authorization: Bearer {{token}}
Content-Type: application/json

{ "rol": "PROFESOR_CAS" }

### CU39 - Asignar como coordinador de CAS
POST {{host}}/api/admin/usuarios/{{idUsuario}}/roles
Authorization: Bearer {{token}}
Content-Type: application/json

{ "rol": "COORD_CAS" }

### CU06 - Registrar profesor
POST {{host}}/api/admin/profesores
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "idUsuario": "{{idUsuario}}",
  "nombre": "Ana",
  "primerApellido": "Mora",
  "segundoApellido": "Rojas",
  "cedula": "{{cedulaProfe}}",
  "numeroCelular": "88888888",
  "fechaNacimiento": "1985-04-12"
}

### CU07 - Listar profesores (búsqueda opcional, sin mayúsculas ni acentos)
GET {{host}}/api/admin/profesores?pagina=1&tamanoPagina=20&busqueda=
Authorization: Bearer {{token}}

### CU07 - Detalle de profesor (por cédula)
GET {{host}}/api/admin/profesores/{{cedulaProfe}}
Authorization: Bearer {{token}}

### CU08 - Modificar profesor
PUT {{host}}/api/admin/profesores/{{cedulaProfe}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nombre": "Ana María",
  "primerApellido": "Mora",
  "segundoApellido": "Rojas",
  "numeroCelular": "87777777",
  "fechaNacimiento": "1985-04-12"
}

### CU10 - Registrar estudiante (la edad 16-19 se valida al matricular, no aquí)
POST {{host}}/api/admin/estudiantes
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nombre": "Luis",
  "primerApellido": "Vargas",
  "segundoApellido": null,
  "cedula": "{{cedulaEst}}",
  "numeroCelular": "86666666",
  "email": "luis.vargas@iet.test",
  "fechaNacimiento": "2009-03-20"
}

### CU11 - Listar estudiantes (búsqueda opcional)
GET {{host}}/api/admin/estudiantes?pagina=1&tamanoPagina=20&busqueda=
Authorization: Bearer {{token}}

### CU11 - Detalle de estudiante (por cédula)
GET {{host}}/api/admin/estudiantes/{{cedulaEst}}
Authorization: Bearer {{token}}

### CU12 - Modificar estudiante
PUT {{host}}/api/admin/estudiantes/{{cedulaEst}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nombre": "Luis Andrés",
  "primerApellido": "Vargas",
  "segundoApellido": null,
  "numeroCelular": "86666666",
  "email": "luis.vargas@iet.test",
  "fechaNacimiento": "2009-03-20"
}

### CU14 - Registrar periodo académico
POST {{host}}/api/admin/periodos
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "anio": {{anio}},
  "inicioSemestreI": "2026-02-02",
  "finSemestreI": "2026-06-30",
  "inicioSemestreII": "2026-07-20",
  "finSemestreII": "2026-11-30"
}

### Periodo actual (año y semestre en curso)
GET {{host}}/api/periodos/actual
Authorization: Bearer {{token}}

### CU15 - Listar periodos
GET {{host}}/api/admin/periodos?pagina=1&tamanoPagina=20
Authorization: Bearer {{token}}

### CU15 - Detalle de periodo
GET {{host}}/api/admin/periodos/{{anio}}
Authorization: Bearer {{token}}

### CU16 - Modificar fechas del periodo
PUT {{host}}/api/admin/periodos/{{anio}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "inicioSemestreI": "2026-02-02",
  "finSemestreI": "2026-06-30",
  "inicioSemestreII": "2026-07-20",
  "finSemestreII": "2026-12-04"
}

### CU18 - Registrar sección 10-1
POST {{host}}/api/admin/secciones
Authorization: Bearer {{token}}
Content-Type: application/json

{ "anio": {{anio}}, "nivel": 10, "numero": 1 }

### CU19 - Listar secciones del año (incluye guía y cantidad de estudiantes)
GET {{host}}/api/admin/secciones?anio={{anio}}&nivel=&pagina=1&tamanoPagina=20
Authorization: Bearer {{token}}

### CU19 - Detalle de sección
GET {{host}}/api/admin/secciones/{{anio}}/10/1
Authorization: Bearer {{token}}

### CU21 - Asociar profesor guía (requiere rol GUIA en periodos abiertos)
PUT {{host}}/api/admin/secciones/{{anio}}/10/1/guia
Authorization: Bearer {{token}}
Content-Type: application/json

{ "cedulaProfesor": "{{cedulaProfe}}" }

### CU26 - Registrar asignatura
POST {{host}}/api/admin/asignaturas
Authorization: Bearer {{token}}
Content-Type: application/json

{ "codigo": "MAT", "nombre": "Matemáticas", "tipo": "MEP", "descripcion": null, "imparteNivel10": true, "imparteNivel11": true }

### CU26 - Registrar asignatura solo de nivel 10 (Cívica: el nivel 11 no la recibe)
POST {{host}}/api/admin/asignaturas
Authorization: Bearer {{token}}
Content-Type: application/json

{ "codigo": "CIV", "nombre": "Educación Cívica", "tipo": "MEP", "descripcion": null, "imparteNivel10": true, "imparteNivel11": false }

### CU26 - Registrar asignatura SUPERIOR (materia de monografía)
POST {{host}}/api/admin/asignaturas
Authorization: Bearer {{token}}
Content-Type: application/json

{ "codigo": "BIO", "nombre": "Biología", "tipo": "SUPERIOR", "descripcion": null, "imparteNivel10": true, "imparteNivel11": true }

### CU26 - Registrar la asignatura CAS (TRONCAL, se identifica por el código CAS)
POST {{host}}/api/admin/asignaturas
Authorization: Bearer {{token}}
Content-Type: application/json

{ "codigo": "CAS", "nombre": "Creatividad, Actividad y Servicio", "tipo": "TRONCAL", "descripcion": null, "imparteNivel10": true, "imparteNivel11": true }

### CU27 - Listar asignaturas (filtros opcionales: tipo, nivel)
GET {{host}}/api/admin/asignaturas?tipo=&nivel=&pagina=1&tamanoPagina=20
Authorization: Bearer {{token}}

### CU28 - Modificar asignatura
PUT {{host}}/api/admin/asignaturas/MAT
Authorization: Bearer {{token}}
Content-Type: application/json

{ "nombre": "Matemáticas", "tipo": "MEP", "descripcion": "Programa del MEP", "imparteNivel10": true, "imparteNivel11": true }

### CU30 - Asignar al profesor la asignatura y sección (se permite co-docencia)
POST {{host}}/api/admin/asignaciones
Authorization: Bearer {{token}}
Content-Type: application/json

{ "anio": {{anio}}, "nivel": 10, "numero": 1, "codigoAsignatura": "MAT", "cedulaProfesor": "{{cedulaProfe}}" }

### CU38 - Asignar el profesor CAS a la sección (asignación de la asignatura CAS; requiere rol PROFESOR_CAS)
POST {{host}}/api/admin/asignaciones
Authorization: Bearer {{token}}
Content-Type: application/json

{ "anio": {{anio}}, "nivel": 10, "numero": 1, "codigoAsignatura": "CAS", "cedulaProfesor": "{{cedulaProfe}}" }

### CU31 - Listar asignaciones (filtros opcionales)
GET {{host}}/api/admin/asignaciones?anio={{anio}}&nivel=&numero=&codigoAsignatura=&cedulaProfesor=
Authorization: Bearer {{token}}

### CU22 - Matricular estudiante (fechaMatricula opcional: null = hoy)
POST {{host}}/api/admin/matriculas
Authorization: Bearer {{token}}
Content-Type: application/json

{ "anio": {{anio}}, "nivel": 10, "numero": 1, "cedulaEstudiante": "{{cedulaEst}}", "fechaMatricula": "2026-02-02" }

### CU34 - Asignar el estudiante a un coordinador de monografía (anio = año de su nivel 10; materia SUPERIOR o MEDIO)
POST {{host}}/api/admin/monografias
Authorization: Bearer {{token}}
Content-Type: application/json

{ "anio": {{anio}}, "cedulaEstudiante": "{{cedulaEst}}", "cedulaCoordinador": "{{cedulaProfe}}", "codigoAsignatura": "BIO" }

### CU35 - Consultar monografías (filtros opcionales: anioInicio, cedulaCoordinador, codigoAsignatura, estado)
GET {{host}}/api/admin/monografias?anioInicio={{anio}}&cedulaCoordinador=&codigoAsignatura=&estado=
Authorization: Bearer {{token}}

### CU35 - Monografía de un estudiante
GET {{host}}/api/admin/monografias/{{cedulaEst}}
Authorization: Bearer {{token}}

### CU36 - Modificar la asignación de monografía (coordinador y materia)
PUT {{host}}/api/admin/monografias/{{cedulaEst}}
Authorization: Bearer {{token}}
Content-Type: application/json

{ "cedulaCoordinador": "{{cedulaProfe}}", "codigoAsignatura": "BIO" }

### Prórroga de notas: más tiempo al profesor para el I semestre (fecha límite posterior al fin del semestre y no pasada)
PUT {{host}}/api/admin/prorrogas/{{anio}}/I_SEMESTRE/{{cedulaProfe}}
Authorization: Bearer {{token}}
Content-Type: application/json

{ "fechaLimite": "2026-12-31" }

### Prórrogas (filtros opcionales: anio, cedulaProfesor)
GET {{host}}/api/admin/prorrogas?anio={{anio}}&cedulaProfesor=
Authorization: Bearer {{token}}

### Quitar la prórroga
DELETE {{host}}/api/admin/prorrogas/{{anio}}/I_SEMESTRE/{{cedulaProfe}}
Authorization: Bearer {{token}}

### CU24 - Estudiantes matriculados en una sección
GET {{host}}/api/admin/matriculas?anio={{anio}}&nivel=10&numero=1&estado=&busqueda=
Authorization: Bearer {{token}}

### CU24 - Historial de matrículas del estudiante
GET {{host}}/api/admin/matriculas?cedulaEstudiante={{cedulaEst}}
Authorization: Bearer {{token}}

### CU23 - Registrar retiro (posterior a la última ausencia y al fin de los semestres calificados: MA009)
PUT {{host}}/api/admin/matriculas/{{anio}}/{{cedulaEst}}/retiro
Authorization: Bearer {{token}}
Content-Type: application/json

{ "fechaRetiro": "2026-09-01", "motivo": "Traslado de colegio" }

### CU23 - Anular retiro
DELETE {{host}}/api/admin/matriculas/{{anio}}/{{cedulaEst}}/retiro
Authorization: Bearer {{token}}

### CU14 - Registrar el periodo siguiente (para subir la sección a nivel 11)
POST {{host}}/api/admin/periodos
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "anio": {{anioSiguiente}},
  "inicioSemestreI": "2027-02-01",
  "finSemestreI": "2027-06-30",
  "inicioSemestreII": "2027-07-19",
  "finSemestreII": "2027-11-30"
}

### CU22 - Subir la sección: matricula en 11-1 del año siguiente a los estudiantes sin retiro de 10-1 (crea la 11-1, sin guía)
POST {{host}}/api/admin/matriculas/subir-seccion
Authorization: Bearer {{token}}
Content-Type: application/json

{ "anio": {{anioSiguiente}}, "numero": 1, "fechaMatricula": null }

### CU24 - Estudiantes de la 11-1 del año siguiente
GET {{host}}/api/admin/matriculas?anio={{anioSiguiente}}&nivel=11&numero=1
Authorization: Bearer {{token}}

# ============================================================
# Vistas del profesor (inicia sesión con el usuario del profesor)
# ============================================================

### Login del profesor
# @name loginProfe
POST {{host}}/api/auth/login
Content-Type: application/json

{ "email": "profe1.nuevo@iet.test", "contrasena": "{{profePass}}" }

###
@tokenProfe = {{loginProfe.response.body.$.accessToken}}

### Profesor Regular CU03 - Mis asignaciones (periodo en curso)
GET {{host}}/api/profesor/asignaciones
Authorization: Bearer {{tokenProfe}}

### Profesor Regular CU04 / Guía CU02 - Estudiantes de una sección donde imparto o soy guía
GET {{host}}/api/profesor/secciones/{{anio}}/10/1/estudiantes
Authorization: Bearer {{tokenProfe}}

### Guía CU01 - Mi sección guía (periodo en curso)
GET {{host}}/api/profesor/guia/secciones
Authorization: Bearer {{tokenProfe}}

### Profesor Regular CU05 - Ficha de un estudiante de la sección (datos personales y matrícula)
GET {{host}}/api/profesor/secciones/{{anio}}/10/1/estudiantes/{{cedulaEst}}
Authorization: Bearer {{tokenProfe}}

# ------------------------------------------------------------
# Ausentismo: el profesor registra cada lección cuando la imparte y marca a los ausentes.
# La fecha no puede ser futura y debe caer en un semestre abierto del periodo.
# ------------------------------------------------------------

### Profesor Regular CU01 - Pantalla principal: asignaciones con plazo de notas abierto y aviso (INFORMATIVO a 30 días, PRIORIDAD a 15)
GET {{host}}/api/profesor/pantalla-principal
Authorization: Bearer {{tokenProfe}}

### Profesor Regular CU10 - Registrar lección con ausentes y llegadas tardías ([] si asistieron todos a tiempo)
# @name leccion
POST {{host}}/api/profesor/lecciones
Authorization: Bearer {{tokenProfe}}
Content-Type: application/json

{
  "anio": {{anio}}, "nivel": 10, "numero": 1, "codigoAsignatura": "MAT",
  "fecha": "2026-09-01", "hora": "07:00:00", "tema": "Funciones", "ausentes": ["{{cedulaEst}}"], "tardias": []
}

###
@idLeccion = {{leccion.response.body.$.idLeccion}}

### Profesor Regular CU12 - Lecciones de mi asignación (semestre opcional: I_SEMESTRE / II_SEMESTRE)
GET {{host}}/api/profesor/lecciones?anio={{anio}}&nivel=10&numero=1&codigoAsignatura=MAT&semestre=
Authorization: Bearer {{tokenProfe}}

### Profesor Regular CU12 - Detalle de la lección con sus ausentes
GET {{host}}/api/profesor/lecciones/{{idLeccion}}
Authorization: Bearer {{tokenProfe}}

### Profesor Regular CU11 - Justificar una ausencia
PUT {{host}}/api/profesor/lecciones/{{idLeccion}}/ausencias/{{cedulaEst}}/justificacion
Authorization: Bearer {{tokenProfe}}
Content-Type: application/json

{ "justificacion": "Cita médica con comprobante" }

### Profesor Regular CU11 - Modificar la lección (reemplaza la lista de ausentes; la justificación se conserva)
PUT {{host}}/api/profesor/lecciones/{{idLeccion}}
Authorization: Bearer {{tokenProfe}}
Content-Type: application/json

{ "fecha": "2026-09-01", "hora": "07:00:00", "tema": "Funciones lineales", "ausentes": ["{{cedulaEst}}"], "tardias": [] }

### Profesor Regular CU12 - Resumen de ausentismo de mi asignación (ausencias contra lecciones)
GET {{host}}/api/profesor/ausentismo?anio={{anio}}&nivel=10&numero=1&codigoAsignatura=MAT&semestre=
Authorization: Bearer {{tokenProfe}}

### Guía CU05 - Ausentismo de mi sección guía por estudiante y asignatura
GET {{host}}/api/profesor/guia/ausentismo?anio={{anio}}&nivel=10&numero=1&semestre=
Authorization: Bearer {{tokenProfe}}

### Profesor Regular CU11 - Anular la justificación
DELETE {{host}}/api/profesor/lecciones/{{idLeccion}}/ausencias/{{cedulaEst}}/justificacion
Authorization: Bearer {{tokenProfe}}

# ------------------------------------------------------------
# Evaluaciones: nota semestral en la escala del tipo de asignatura (SUPERIOR/MEDIO 1-7, TRONCAL A-E, MEP 0-100).
# Se registran desde el inicio del semestre hasta el cierre (fin del semestre o prórroga) y se envían al guía.
# ------------------------------------------------------------

### Profesor Regular CU06 / CU09 - Registrar notas y observaciones (solo cambian los estudiantes indicados)
PUT {{host}}/api/profesor/evaluaciones
Authorization: Bearer {{tokenProfe}}
Content-Type: application/json

{
  "anio": {{anio}}, "nivel": 10, "numero": 1, "codigoAsignatura": "MAT", "semestre": "II_SEMESTRE",
  "notas": [ { "cedulaEstudiante": "{{cedulaEst}}", "nota": "85", "observaciones": "Buen análisis de problemas." } ]
}

### Profesor Regular CU08 - Estado y notas de mi asignación en el semestre
GET {{host}}/api/profesor/evaluaciones?anio={{anio}}&nivel=10&numero=1&codigoAsignatura=MAT&semestre=II_SEMESTRE
Authorization: Bearer {{tokenProfe}}

### Profesor Regular CU14 - Enviar el registro de bandas al guía (todos los estudiantes con nota)
POST {{host}}/api/profesor/evaluaciones/envio
Authorization: Bearer {{tokenProfe}}
Content-Type: application/json

{ "anio": {{anio}}, "nivel": 10, "numero": 1, "codigoAsignatura": "MAT", "semestre": "II_SEMESTRE" }

### Guía CU03 / CU04 - Notas de una sección (cualquier sección; solo notas enviadas)
GET {{host}}/api/profesor/guia/notas?anio={{anio}}&nivel=10&numero=1&semestre=II_SEMESTRE
Authorization: Bearer {{tokenProfe}}

# ------------------------------------------------------------
# Monografía (coordinador y guía)
# ------------------------------------------------------------

### Coordinador de Monografía CU01 - Mis monografías (filtros opcionales: anioInicio, estado)
GET {{host}}/api/profesor/monografias?anioInicio=&estado=
Authorization: Bearer {{tokenProfe}}

### Coordinador de Monografía CU02 - Cambiar el estado (CAPACITACION, INVESTIGACION, TERMINADA)
PUT {{host}}/api/profesor/monografias/{{cedulaEst}}/estado
Authorization: Bearer {{tokenProfe}}
Content-Type: application/json

{ "estado": "INVESTIGACION" }

### Coordinador de Monografía CU03 - Registrar seguimiento (fecha opcional: hoy)
# @name seguimiento
POST {{host}}/api/profesor/monografias/{{cedulaEst}}/seguimientos
Authorization: Bearer {{tokenProfe}}
Content-Type: application/json

{ "fecha": null, "observacion": "Definió la pregunta de investigación." }

###
@idSeguimiento = {{seguimiento.response.body.$.idSeguimiento}}

### Coordinador de Monografía CU04 - Modificar seguimiento
PUT {{host}}/api/profesor/monografias/seguimientos/{{idSeguimiento}}
Authorization: Bearer {{tokenProfe}}
Content-Type: application/json

{ "fecha": "2026-09-29", "observacion": "Definió la pregunta de investigación y el índice." }

### Coordinador de Monografía CU05 - Enviar el reporte del semestre al guía (sale en el reporte de bandas)
PUT {{host}}/api/profesor/monografias/{{cedulaEst}}/reportes/{{anio}}/II_SEMESTRE
Authorization: Bearer {{tokenProfe}}
Content-Type: application/json

{ "observaciones": "Buen avance; debe completar el marco teórico." }

### Coordinador de Monografía CU01 - Monografía con su seguimiento y reportes
GET {{host}}/api/profesor/monografias/{{cedulaEst}}
Authorization: Bearer {{tokenProfe}}

### Guía CU07 - Verificar las monografías de mi sección guía (estado y seguimiento)
GET {{host}}/api/profesor/guia/monografias?anio={{anio}}&nivel=10&numero=1
Authorization: Bearer {{tokenProfe}}

### Guía CU06 - Reportes de monografía de mi sección guía en el semestre
GET {{host}}/api/profesor/guia/monografias/reportes?anio={{anio}}&nivel=10&numero=1&semestre=II_SEMESTRE
Authorization: Bearer {{tokenProfe}}

# ------------------------------------------------------------
# CAS: informe semestral por estudiante (formato del Instituto; el front arma el PDF)
# ------------------------------------------------------------

### Profesor CAS CU01 / CU02 - Registrar o modificar el informe CAS del estudiante
PUT {{host}}/api/profesor/cas/informes/{{anio}}/II_SEMESTRE/{{cedulaEst}}
Authorization: Bearer {{tokenProfe}}
Content-Type: application/json

{
  "perfil": true, "entrevista1": true, "entrevista2": false, "entrevistaFinal": false,
  "observaciones": "Agregar el índice y una página que indique el semestre.",
  "experiencias": [
    { "descripcion": "Recibimiento de los 12° BI", "fecha": "2026-08-06", "creatividad": true, "actividad": false, "servicio": true,
      "resultadosAprendizaje": [1, 2, 3], "carpeta": true, "reflexion": true, "pruebas": false },
    { "descripcion": "Trabajo de zona verde costado norte", "fecha": null, "creatividad": false, "actividad": true, "servicio": true,
      "resultadosAprendizaje": [4, 5], "carpeta": true, "reflexion": false, "pruebas": true }
  ]
}

### Profesor CAS CU03 - Informe CAS del estudiante
GET {{host}}/api/profesor/cas/informes/{{anio}}/II_SEMESTRE/{{cedulaEst}}
Authorization: Bearer {{tokenProfe}}

### Profesor CAS CU03 - Progreso de mi sección CAS en el semestre
GET {{host}}/api/profesor/cas/informes?anio={{anio}}&nivel=10&numero=1&semestre=II_SEMESTRE
Authorization: Bearer {{tokenProfe}}

### Nota CAS del semestre (se registra con evaluaciones: TRONCAL, letras A a E)
PUT {{host}}/api/profesor/evaluaciones
Authorization: Bearer {{tokenProfe}}
Content-Type: application/json

{ "anio": {{anio}}, "nivel": 10, "numero": 1, "codigoAsignatura": "CAS", "semestre": "II_SEMESTRE", "notas": [ { "cedulaEstudiante": "{{cedulaEst}}", "nota": "A" } ] }

### Coordinador de CAS CU01 - Progreso CAS general (nivel y número opcionales; nota solo si ya se envió)
GET {{host}}/api/profesor/coordinacion-cas/progreso?anio={{anio}}&semestre=II_SEMESTRE&nivel=&numero=
Authorization: Bearer {{tokenProfe}}

### Coordinador de CAS CU02 - Reporte CAS del estudiante (datos para el PDF)
GET {{host}}/api/profesor/coordinacion-cas/informes/{{anio}}/II_SEMESTRE/{{cedulaEst}}
Authorization: Bearer {{tokenProfe}}

# ------------------------------------------------------------
# Reporte de bandas del guía (datos para el PDF)
# ------------------------------------------------------------

### Guía CU09 - Reporte de bandas de toda la sección guía
GET {{host}}/api/profesor/guia/reporte-bandas?anio={{anio}}&nivel=10&numero=1&semestre=II_SEMESTRE
Authorization: Bearer {{tokenProfe}}

### Guía CU08 - Reporte de bandas de un estudiante
GET {{host}}/api/profesor/guia/reporte-bandas/{{cedulaEst}}?anio={{anio}}&nivel=10&numero=1&semestre=II_SEMESTRE
Authorization: Bearer {{tokenProfe}}

# ============================================================
# Borrados (en este orden por las dependencias)
# ============================================================

### Profesor Regular CU11 - Eliminar la lección (y sus ausencias; antes de borrar la matrícula y la asignación)
DELETE {{host}}/api/profesor/lecciones/{{idLeccion}}
Authorization: Bearer {{tokenProfe}}

### Profesor CAS CU04 - Eliminar el informe CAS
DELETE {{host}}/api/profesor/cas/informes/{{anio}}/II_SEMESTRE/{{cedulaEst}}
Authorization: Bearer {{tokenProfe}}

### Profesor Regular CU07 - Eliminar la nota CAS (corrección; anula el envío si lo había)
DELETE {{host}}/api/profesor/evaluaciones/{{anio}}/10/1/CAS/II_SEMESTRE/{{cedulaEst}}
Authorization: Bearer {{tokenProfe}}

### Profesor Regular CU07 - Eliminar la nota de MAT (anula el envío: hay que volver a enviar)
DELETE {{host}}/api/profesor/evaluaciones/{{anio}}/10/1/MAT/II_SEMESTRE/{{cedulaEst}}
Authorization: Bearer {{tokenProfe}}

### Coordinador de Monografía CU05 - Retirar el reporte del semestre
DELETE {{host}}/api/profesor/monografias/{{cedulaEst}}/reportes/{{anio}}/II_SEMESTRE
Authorization: Bearer {{tokenProfe}}

### Coordinador de Monografía CU04 - Eliminar el seguimiento
DELETE {{host}}/api/profesor/monografias/seguimientos/{{idSeguimiento}}
Authorization: Bearer {{tokenProfe}}

### CU37 - Eliminar la monografía (sin seguimiento ni reportes)
DELETE {{host}}/api/admin/monografias/{{cedulaEst}}
Authorization: Bearer {{token}}

### CU33 - Eliminar la asignación de CAS
DELETE {{host}}/api/admin/asignaciones/{{anio}}/10/1/CAS/{{cedulaProfe}}
Authorization: Bearer {{token}}

### CU25 - Eliminar la matrícula de nivel 11 (primero la continuidad: MA007)
DELETE {{host}}/api/admin/matriculas/{{anioSiguiente}}/{{cedulaEst}}
Authorization: Bearer {{token}}

### CU20 - Eliminar la sección 11-1 (antes que la 10-1: SE006)
DELETE {{host}}/api/admin/secciones/{{anioSiguiente}}/11/1
Authorization: Bearer {{token}}

### CU17 - Eliminar el periodo siguiente
DELETE {{host}}/api/admin/periodos/{{anioSiguiente}}
Authorization: Bearer {{token}}

### CU25 - Eliminar matrícula
DELETE {{host}}/api/admin/matriculas/{{anio}}/{{cedulaEst}}
Authorization: Bearer {{token}}

### CU33 - Eliminar asignación
DELETE {{host}}/api/admin/asignaciones/{{anio}}/10/1/MAT/{{cedulaProfe}}
Authorization: Bearer {{token}}

### CU21 - Quitar profesor guía
DELETE {{host}}/api/admin/secciones/{{anio}}/10/1/guia
Authorization: Bearer {{token}}

### CU20 - Eliminar sección
DELETE {{host}}/api/admin/secciones/{{anio}}/10/1
Authorization: Bearer {{token}}

### CU29 - Eliminar asignaturas
DELETE {{host}}/api/admin/asignaturas/CIV
Authorization: Bearer {{token}}

###
DELETE {{host}}/api/admin/asignaturas/MAT
Authorization: Bearer {{token}}

###
DELETE {{host}}/api/admin/asignaturas/BIO
Authorization: Bearer {{token}}

###
DELETE {{host}}/api/admin/asignaturas/CAS
Authorization: Bearer {{token}}

### CU17 - Eliminar periodo (solo sin secciones)
DELETE {{host}}/api/admin/periodos/{{anio}}
Authorization: Bearer {{token}}

### CU13 - Eliminar estudiante
DELETE {{host}}/api/admin/estudiantes/{{cedulaEst}}
Authorization: Bearer {{token}}

### CU09 - Eliminar profesor
DELETE {{host}}/api/admin/profesores/{{cedulaProfe}}
Authorization: Bearer {{token}}

### CU04 - Revocar rol
DELETE {{host}}/api/admin/usuarios/{{idUsuario}}/roles/GUIA
Authorization: Bearer {{token}}

### CU05 - Eliminar usuario (elimina antes el perfil de profesor si lo tiene)
DELETE {{host}}/api/admin/usuarios/{{idUsuario}}
Authorization: Bearer {{token}}

### Cerrar sesión (logout de esta sesión; responde 204 aunque el token no exista)
POST {{host}}/api/auth/logout
Content-Type: application/json

{ "refreshToken": "{{refresh}}" }

### Cambiar mi contraseña (cierra todas las sesiones: hay que volver a iniciar sesión)
POST {{host}}/api/auth/cambiar-contrasena
Authorization: Bearer {{token}}
Content-Type: application/json

{ "contrasenaActual": "{{adminPass}}", "contrasenaNueva": "Nueva12345" }

### Iniciar sesión con la contraseña nueva
# @name login2
POST {{host}}/api/auth/login
Content-Type: application/json

{ "email": "{{adminEmail}}", "contrasena": "Nueva12345" }

### Cerrar todas mis sesiones
POST {{host}}/api/auth/logout-all
Authorization: Bearer {{login2.response.body.$.accessToken}}
